<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher mark: the app's Showdown gem — double gold diamond with a solid core,
     kept inside the 66dp safe zone of the 108dp adaptive canvas. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- outer diamond -->
    <path
        android:pathData="M54,25 L83,54 L54,83 L25,54 Z"
        android:strokeColor="@color/gold"
        android:strokeWidth="2.6"
        android:strokeLineJoin="miter"
        android:fillColor="#00000000" />
    <!-- inner diamond -->
    <path
        android:pathData="M54,34 L74,54 L54,74 L34,54 Z"
        android:strokeColor="@color/gold_mid"
        android:strokeWidth="1.4"
        android:fillColor="#00000000" />
    <!-- seam line -->
    <path
        android:pathData="M18,54 L34,54 M74,54 L90,54"
        android:strokeColor="@color/gold_mid"
        android:strokeWidth="1.4" />
    <!-- core -->
    <path
        android:pathData="M54,46 L62,54 L54,62 L46,54 Z"
        android:fillColor="@color/gold" />
</vector>
